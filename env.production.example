# ===================================
# 生產環境配置範例
# ===================================
# 使用方式：複製此檔案為 .env.production，並填入實際的值
# cp env.production.example .env.production

# ===================================
# 網域配置
# ===================================
# 您的實際網域名稱
DASHBOARD_DOMAIN=dashboard.sihai.baimeng.co
API_DOMAIN=api.sihai.baimeng.co

# ===================================
# 資料庫配置
# ===================================
# PostgreSQL 連接字串
# 格式：postgresql://用戶名:密碼@主機:端口/資料庫名
DATABASE_URL=postgresql://smartcater_user:your_password@db:5432/smartcater_db
DB_HOST=host.docker.internal
DB_PORT=5432
POSTGRES_USER=smartcater_prod
POSTGRES_PASSWORD=
POSTGRES_DB=smartcater_prod_db

# ===================================
# JWT 安全配置
# ===================================
# 請使用強密碼！建議使用以下命令生成：
# openssl rand -hex 32
SECRET_KEY=your-secret-key-here-please-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================================
# API 配置
# ===================================
# 如果不使用內部 API，可以指向外部 API
# API_URL=https://your-external-api.com/api/v1



# ===================================
# 日誌配置
# ===================================
LOG_LEVEL=INFO

# ===================================
# Email 配置（選用，用於憑證更新通知）
# ===================================
CERTBOT_EMAIL=admin@sihai.baimeng.co

