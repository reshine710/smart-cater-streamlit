# ==========================================
# Secrets 環境變數範例配置 (secrets.toml.example)
# ==========================================
# 請將此檔案複製為 .secrets.toml 並填入實際機敏數值 (請勿提交 .secrets.toml 到版本控制)
# 由於使用了 Dynaconf，設定檔內的變數不需要加上 DYNACONF_ 前綴。
#
# 注意：若您的運行環境中有設定 ENV_FOR_DYNACONF=production，
# 系統將會自動載入 [production] 區塊內的設定。

[production]
# 對應 GCP 設定的 DYNACONF_INSTANCE_CONNECTION_NAME
# Cloud SQL 的連線名稱格式通常為：project-id:region:instance-name
INSTANCE_CONNECTION_NAME = "smart-cater-backend-486803:asia-east1:smartcater-db"

# 對應 GCP 設定的 DYNACONF_API_URL
# 後端 API 服務的根網址
API_URL = "https://smartcater-backend-582253760974.asia-east1.run.app/api/v1"

# 對應 GCP 設定的 DYNACONF_POSTGRES_PASSWORD
# 在 GCP Cloud Run 中，這通常會從 Secret Manager 引入 (例如寫為 "latest" 的密鑰)
# 在本機或這個檔案中，請填寫實際的資料庫密碼
POSTGRES_PASSWORD = "your_actual_db_password"
